{
  "name": "mythical-maps",
  "version": "0.1.0",
  "description": "TTRPG map management for Obsidian: maps as first-class .map files, no code blocks in notes.",
  "main": "main.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs dev",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "fixtures": "node scripts/make-fixture-images.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@geoman-io/leaflet-geoman-free": "2.20.8",
    "fractional-indexing": "4.0.0",
    "leaflet": "1.9.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.5",
    "builtin-modules": "5.5.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "obsidian": "1.14.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
